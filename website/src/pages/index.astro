---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Layout from '../layouts/Layout.astro';
import { androidPreview, getAndroidPreviewView, releasesUrl } from '../data/releases.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const androidRelease = getAndroidPreviewView(androidPreview);

const desktopScreenshots = [
  { file: 'overlay-main.png', title: 'Main overlay', text: 'Full desktop overlay with an active layout and live pressed-key highlighting.' },
  { file: 'menu-keyboard.png', title: 'Application menu', text: 'Keyboard, Language, and Connection flyouts keep daily controls and recovery actions close.' },
  { file: 'settings-window.png', title: 'Desktop settings', text: 'Settings for enabled layouts, startup layout, external files, and the global show/hide shortcut.' },
  { file: 'mini-mode.png', title: 'Mini Mode', text: 'Compact desktop overlay for passive visualization with a direct restore control.' },
  { file: 'self-test.png', title: 'Keyboard Self-test', text: 'Guided HID-output verification using outlines on the existing desktop overlay.' },
  { file: 'menu-language.png', title: 'macOS language sync', text: 'Language flyout showing input-source synchronization status for compatible ZMK keyboards.' },
  { file: 'typing-invaders.png', title: 'Shift-Space Invaders', text: 'A separate desktop typing-practice window with focused input ownership.' },
];

const androidScreenshots = [
  { file: 'android-browse.png', title: 'Browse workspace', text: 'Android Companion Browse workspace showing a selected keyboard layout.' },
  { file: 'android-settings.png', title: 'Adaptive Settings', text: 'Android Companion adaptive Settings with connection, layout, and status sections.' },
  { file: 'android-live.png', title: 'Read-only Live', text: 'Android Companion Live view following read-only keyboard layer and key telemetry.' },
];

function screenshotSlots(definitions) {
  return definitions.map((shot) => ({
    ...shot,
    src: `${base}/images/${shot.file}`,
    available: existsSync(fileURLToPath(new URL(`../../public/images/${shot.file}`, import.meta.url))),
  }));
}

const desktopSlots = screenshotSlots(desktopScreenshots);
const androidSlots = screenshotSlots(androidScreenshots);
---
<Layout title="Keyboard Helper" description="Keyboard visualization for desktop and an Android companion preview for Browse, connection evidence, and compatible read-only Live telemetry.">
  <style>
    .hero { margin-bottom: 52px; }
    .hero h1 { font-size: clamp(2.15rem, 7vw, 3.7rem); font-weight: 700; line-height: 1.04; margin: 10px 0 18px; max-width: 760px; }
    .hero p { color: var(--text-muted); font-size: 1.08rem; line-height: 1.65; max-width: 720px; }
    .eyebrow, .scope, .release-label { color: var(--accent); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
    .btn { border-radius: 8px; display: inline-block; font-size: 0.93rem; font-weight: 700; padding: 11px 18px; text-decoration: none; }
    .btn:hover { opacity: 0.86; text-decoration: none; }
    .btn-primary { background: var(--accent); color: #081018; }
    .btn-primary:hover { color: #081018; }
    .btn-outline { background: var(--bg2); border: 1px solid var(--border); color: var(--text); }
    .btn-outline:hover { color: var(--text); }
    .section { margin: 54px 0; }
    .section h2 { font-size: 1.45rem; margin-bottom: 10px; }
    .section-intro { color: var(--text-muted); line-height: 1.65; margin-bottom: 22px; max-width: 760px; }
    .product-grid, .feature-grid, .status-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
    .product-card, .feature-card, .status-card, .shot-card, .download, .release-note { background: var(--bg2); border: 1px solid var(--border); border-radius: 10px; padding: 22px; }
    .product-card { display: flex; flex-direction: column; min-height: 250px; }
    .product-card h2 { color: var(--accent); font-size: 1.35rem; margin: 9px 0 10px; }
    .product-card p, .feature-card p, .status-card p, .shot-card p, .download p, .release-note p { color: var(--text-muted); font-size: 0.92rem; line-height: 1.62; }
    .product-card .cta { margin-top: auto; padding-top: 18px; }
    .feature-card h3, .status-card h3, .shot-card h3 { color: var(--accent); font-size: 1rem; margin-bottom: 8px; }
    .scope { color: var(--text); display: block; margin-top: 13px; }
    .shot-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
    .shot-image, .shot-placeholder { align-items: center; aspect-ratio: 16 / 10; background: linear-gradient(135deg, rgba(60, 201, 199, 0.16), transparent 42%), var(--key-bg); border: 1px dashed rgba(228, 231, 239, 0.26); border-radius: 8px; color: var(--text); display: flex; justify-content: center; margin-bottom: 14px; min-height: 150px; padding: 18px; text-align: center; }
    .shot-image { background: #f4f4f4; display: block; object-fit: contain; padding: 0; width: 100%; }
    .shot-placeholder strong { display: block; margin-bottom: 6px; }
    .shot-placeholder span { color: var(--text-muted); display: block; font-family: "Cascadia Code", "Fira Code", "Courier New", monospace; font-size: 0.78rem; overflow-wrap: anywhere; }
    .release-note { border-color: rgba(60, 201, 199, 0.35); }
    .release-label { display: block; margin-bottom: 8px; }
    .download h2 { font-size: 1.2rem; margin-bottom: 8px; }
    @media (max-width: 420px) { .cta { align-items: stretch; flex-direction: column; } .btn { text-align: center; width: 100%; } }
  </style>

  <section class="hero">
    <span class="eyebrow">Desktop overlay + Android Companion</span>
    <h1>See what your keyboard is doing, wherever you are working.</h1>
    <p>Keyboard Helper pairs a mature desktop overlay with a foreground Android companion. Visualize layouts, inspect connection evidence, and follow compatible ZMK activity without pretending every platform has the same powers.</p>
    <div class="cta"><a class="btn btn-primary" href={`${base}/setup/`}>Set up desktop</a><a class="btn btn-outline" href={`${base}/android/`}>Explore Android</a><a class="btn btn-outline" href={`${base}/faq/`}>Troubleshooting</a></div>
  </section>

  <section class="product-grid" aria-label="Keyboard Helper products">
    <article class="product-card">
      <span class="eyebrow">macOS · Windows · Linux</span><h2>Desktop overlay</h2>
      <p>Keep a global, always-on-top keyboard view beside any app. Highlight keys, follow compatible BLE layers, manage layouts, run guided self-test, and use desktop-only tools.</p>
      <div class="cta"><a class="btn btn-primary" href={`${base}/setup/`}>Desktop setup</a><a class="btn btn-outline" href={releasesUrl} target="_blank" rel="noopener">Desktop releases</a></div>
    </article>
    <article class="product-card">
      <span class="eyebrow">Foreground companion · Android preview</span><h2>Android Companion</h2>
      <p>Browse keyboard layouts, inspect connection evidence, and follow compatible read-only Live telemetry from a phone. The companion never switches the keyboard's remote layer.</p>
      <p><strong>{androidRelease.status}</strong></p>
      <div class="cta"><a class="btn btn-primary" href={`${base}/android/`}>Android guide</a>{androidRelease.published && <a class="btn btn-outline" href={androidRelease.releaseUrl} target="_blank" rel="noopener">Open {androidRelease.version}</a>}</div>
    </article>
  </section>

  <section class="section" aria-labelledby="platform-status">
    <h2 id="platform-status">Platform status</h2>
    <div class="status-grid">
      <article class="status-card"><h3>Desktop</h3><p>Available for macOS, Windows, and Linux with the global overlay, diagnostics, and platform-scoped synchronization tools.</p></article>
      <article class="status-card"><h3>Android preview</h3><p>{androidRelease.status} Public physical BLE acceptance remains API 31+ and arm64.</p></article>
      <article class="status-card"><h3>iOS</h3><p>Unavailable. There is no iOS build, signing channel, or promised availability date.</p></article>
    </div>
  </section>

  <section class="section" aria-labelledby="desktop-features">
    <h2 id="desktop-features">Desktop outcomes</h2><p class="section-intro">The desktop app remains the full overlay experience and owns global input, local configuration, and desktop-specific integrations.</p>
    <div class="feature-grid">
      <article class="feature-card"><h3>Live global overlay</h3><p>Pressed keys highlight while the transparent window shows the selected layout and compatible firmware layer.</p><span class="scope">Desktop app</span></article>
      <article class="feature-card"><h3>Setup and diagnostics</h3><p>Configure built-in or JSON layouts, recover permissions, reconnect BLE, and run guided HID-output self-test.</p><span class="scope">Desktop app</span></article>
      <article class="feature-card"><h3>Focused tools</h3><p>Use Mini Mode, macOS input-source sync where supported, and Shift-Space Invaders without changing the Android companion contract.</p><span class="scope">Platform-scoped</span></article>
    </div>
  </section>

  <section class="section" aria-labelledby="android-outcomes">
    <h2 id="android-outcomes">Android outcomes</h2><p class="section-intro">The signed preview is a foreground companion: Browse works with stock firmware, while Live needs the compatible enhanced read-only telemetry extension.</p>
    <div class="feature-grid">
      <article class="feature-card"><h3>Browse layouts</h3><p>View bundled and validated custom layouts on a phone without requiring enhanced firmware.</p><span class="scope">Stock or enhanced ZMK</span></article>
      <article class="feature-card"><h3>Connection evidence</h3><p>See honest permission, pairing, connection, battery, and device-information evidence when the keyboard exposes it.</p><span class="scope">API 31+ physical baseline</span></article>
      <article class="feature-card"><h3>Compatible Live</h3><p>Follow read-only layer, key, combo, and diagnostic telemetry. The phone does not write remote layer changes.</p><span class="scope">Enhanced firmware</span></article>
    </div>
  </section>

  <section class="section" aria-labelledby="desktop-tour">
    <h2 id="desktop-tour">Desktop product tour</h2><p class="section-intro">Clean captures from the current desktop experience replace mock imagery and retain an accessible fallback if an asset is removed.</p>
    <div class="shot-grid">
      {desktopSlots.map((shot) => <article class="shot-card">{shot.available ? <img class="shot-image" src={shot.src} alt={shot.text} loading="lazy" /> : <div class="shot-placeholder" role="img" aria-label={shot.text}><div><strong>{shot.title}</strong><span>public/images/{shot.file}</span></div></div>}<h3>{shot.title}</h3><p>{shot.text}</p></article>)}
    </div>
  </section>

  <section class="section" aria-labelledby="android-tour">
    <h2 id="android-tour">Android workspace tour</h2>
    {androidRelease.adaptiveWorkspace ? (
      <><p class="section-intro">These captures match the adaptive workspace in the linked {androidRelease.version} preview.</p><div class="shot-grid">{androidSlots.map((shot) => <article class="shot-card">{shot.available ? <img class="shot-image" src={shot.src} alt={shot.text} loading="lazy" /> : <div class="shot-placeholder" role="img" aria-label={shot.text}><div><strong>{shot.title}</strong><span>public/images/{shot.file}</span></div></div>}<h3>{shot.title}</h3><p>{shot.text}</p></article>)}</div></>
    ) : (
      <div class="release-note"><span class="release-label">Later release preview — not in {androidRelease.version ?? 'the linked APK'}</span><p>The repository contains a newer viewport-first Browse/Live workspace and adaptive Settings design. Its navigation and screenshots will appear here only after a signed release containing that workspace is published and accepted.</p></div>
    )}
  </section>

  <section class="download"><h2>Choose your path</h2><p>Start with the guide for the product you are using; both guides keep platform-specific permissions and support boundaries explicit.</p><div class="cta"><a class="btn btn-primary" href={`${base}/setup/`}>Desktop setup</a><a class="btn btn-outline" href={`${base}/android/`}>Android guide</a></div></section>
</Layout>
