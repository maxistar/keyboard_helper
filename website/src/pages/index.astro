---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const screenshotDefinitions = [
  {
    file: 'overlay-main.png',
    title: 'Main overlay',
    text: 'Full Keyboard Helper overlay with an active layout and live pressed-key highlighting.',
  },
  {
    file: 'menu-keyboard.png',
    title: 'Application menu',
    text: 'Keyboard, Language, and Connection flyouts with layout reload, BLE reconnect, and direct actions.',
  },
  {
    file: 'settings-window.png',
    title: 'Settings window',
    text: 'Native settings for enabled layouts, startup layout, external layout files, and the show/hide shortcut.',
  },
  {
    file: 'mini-mode.png',
    title: 'Mini Mode',
    text: 'Compact overlay that keeps live visualization visible while hiding persistent controls.',
  },
  {
    file: 'self-test.png',
    title: 'Keyboard Self-test',
    text: 'Guided HID-output verification with outlines on the existing overlay.',
  },
  {
    file: 'menu-language.png',
    title: 'macOS language sync',
    text: 'Language flyout showing macOS input-source synchronization status for compatible ZMK keyboards.',
  },
  {
    file: 'typing-invaders.png',
    title: 'Shift-Space Invaders',
    text: 'Separate typing arcade window for practicing focused keyboard input.',
  },
];

const screenshotSlots = screenshotDefinitions.map((shot) => ({
  ...shot,
  src: `${base}/images/${shot.file}`,
  available: existsSync(fileURLToPath(new URL(`../../public/images/${shot.file}`, import.meta.url))),
}));
---
<Layout title="Keyboard Helper" description="A desktop overlay for visualizing keyboard layouts, live key presses, ZMK layers, and setup diagnostics.">
  <style>
    .hero { margin-bottom: 56px; }
    .hero h1 { font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 700; line-height: 1.05; margin-bottom: 18px; }
    .hero p { color: var(--text-muted); font-size: 1.08rem; line-height: 1.65; max-width: 680px; }
    .eyebrow { color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
    .btn { border-radius: 8px; display: inline-block; font-size: 0.95rem; font-weight: 700; padding: 11px 20px; }
    .btn:hover { opacity: 0.86; text-decoration: none; }
    .btn-primary { background: var(--accent); color: #081018; }
    .btn-outline { background: var(--bg2); border: 1px solid var(--border); color: var(--text); }
    .section { margin: 56px 0; }
    .section h2 { font-size: 1.35rem; margin-bottom: 10px; }
    .section-intro { color: var(--text-muted); line-height: 1.65; margin-bottom: 22px; max-width: 720px; }
    .feature-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
    .feature-card, .shot-card, .download {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 20px;
    }
    .feature-card h3, .shot-card h3 { color: var(--accent); font-size: 0.98rem; margin-bottom: 8px; }
    .feature-card p, .shot-card p, .download p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.58; }
    .feature-card .scope { color: var(--text); display: block; font-size: 0.76rem; font-weight: 700; margin-top: 12px; text-transform: uppercase; }
    .shot-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .shot-image,
    .shot-placeholder {
      align-items: center;
      aspect-ratio: 16 / 10;
      background:
        linear-gradient(135deg, rgba(60, 201, 199, 0.16), transparent 42%),
        var(--key-bg);
      border: 1px dashed rgba(228, 231, 239, 0.26);
      border-radius: 8px;
      color: var(--text);
      display: flex;
      justify-content: center;
      margin-bottom: 14px;
      min-height: 150px;
      padding: 18px;
      text-align: center;
    }
    .shot-image {
      background: #f4f4f4;
      display: block;
      object-fit: contain;
      padding: 0;
      width: 100%;
    }
    .shot-placeholder strong { display: block; margin-bottom: 6px; }
    .shot-placeholder span { color: var(--text-muted); display: block; font-family: "Cascadia Code", "Fira Code", "Courier New", monospace; font-size: 0.8rem; overflow-wrap: anywhere; }
    .workflow { border-left: 3px solid var(--accent); display: grid; gap: 10px; padding-left: 18px; }
    .workflow p { color: var(--text-muted); line-height: 1.6; }
    .download { margin-top: 56px; }
    .download h2 { font-size: 1.2rem; margin-bottom: 8px; }
  </style>

  <section class="hero">
    <span class="eyebrow">Keyboard visualization and diagnostics</span>
    <h1>Keyboard Helper shows what your keyboard is doing.</h1>
    <p>
      A desktop overlay for split, ergonomic, and standard keyboards. It highlights live key presses,
      follows ZMK layers over BLE, helps verify custom layouts, and keeps setup controls close without
      hiding the keyboard view.
    </p>
    <div class="cta">
      <a class="btn btn-primary" href={`${base}/setup/`}>Start setup</a>
      <a class="btn btn-outline" href="https://github.com/maxistar/keyboard_helper/releases" target="_blank" rel="noopener">Download release</a>
      <a class="btn btn-outline" href={`${base}/faq/`}>Troubleshooting</a>
    </div>
  </section>

  <section class="section" aria-labelledby="feature-overview">
    <h2 id="feature-overview">Current Features</h2>
    <p class="section-intro">
      Keyboard Helper is built around the overlay, but the current app also includes setup, recovery,
      diagnostics, synchronization, and practice tools.
    </p>
    <div class="feature-grid">
      <article class="feature-card"><h3>Live overlay</h3><p>Pressed keys highlight globally while the always-on-top transparent window shows the active layout.</p><span class="scope">macOS, Windows, Linux</span></article>
      <article class="feature-card"><h3>Built-in and custom layouts</h3><p>Use Corne, Dactyl, QWERTY, QWERTZ, Mac, Magic, or add an external JSON layout through Settings.</p><span class="scope">Settings + JSON</span></article>
      <article class="feature-card"><h3>Application menu</h3><p>Keyboard, Language, and Connection flyouts keep layout selection, reload, sync state, and recovery actions organized.</p><span class="scope">Primary control surface</span></article>
      <article class="feature-card"><h3>ZMK BLE layer sync</h3><p>Compatible keyboards can report their authoritative layer over Bluetooth so the overlay follows firmware state.</p><span class="scope">BLE-capable layouts</span></article>
      <article class="feature-card"><h3>macOS language sync</h3><p>Layouts can map installed macOS input sources to ZMK language layers and reconcile stable mismatches through writable BLE.</p><span class="scope">macOS + compatible ZMK</span></article>
      <article class="feature-card"><h3>Guided self-test</h3><p>Verify one layout layer position by position using HID events and outlines on the existing overlay.</p><span class="scope">Desktop app</span></article>
      <article class="feature-card"><h3>Mini Mode</h3><p>Shrink the overlay for passive monitoring while preserving live highlighting and a direct restore control.</p><span class="scope">Desktop app</span></article>
      <article class="feature-card"><h3>Shift-Space Invaders</h3><p>Open a separate typing arcade window that owns its focused input while the overlay can continue visualizing keys.</p><span class="scope">Practice mode</span></article>
      <article class="feature-card"><h3>Tray and hotkey recovery</h3><p>Closing hides to tray, and an optional global shortcut or CLI toggle can show or hide the overlay.</p><span class="scope">Daily workflow</span></article>
    </div>
  </section>

  <section class="section" aria-labelledby="menu-workflow">
    <h2 id="menu-workflow">The App Menu Is The Map</h2>
    <div class="workflow">
      <p><strong>Keyboard</strong> contains layout choices, Reload layout for external files, and Keyboard Self-test.</p>
      <p><strong>Language</strong> appears for valid macOS input-source synchronization metadata and shows source status.</p>
      <p><strong>Connection</strong> shows BLE state and Reconnect BLE when the active layout supports it.</p>
      <p><strong>Root actions</strong> open Mini Mode, Shift-Space Invaders, Settings, and Help.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="screenshots">
    <h2 id="screenshots">Product Tour</h2>
    <p class="section-intro">
      See the overlay, application controls, diagnostics, synchronization, and practice tools in the current app.
    </p>
    <div class="shot-grid">
      {screenshotSlots.map((shot) => (
        <article class="shot-card">
          {shot.available ? (
            <img class="shot-image" src={shot.src} alt={shot.text} loading="lazy" />
          ) : (
            <div class="shot-placeholder" role="img" aria-label={shot.text}>
              <div><strong>{shot.title}</strong><span>public/images/{shot.file}</span></div>
            </div>
          )}
          <h3>{shot.title}</h3>
          <p>{shot.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="download">
    <h2>Ready to try it?</h2>
    <p>Download a release for macOS, Windows, or Linux, then follow the setup guide for first launch, permissions, and configuration.</p>
    <div class="cta">
      <a class="btn btn-primary" href={`${base}/setup/`}>Open setup guide</a>
      <a class="btn btn-outline" href="https://github.com/maxistar/keyboard_helper/releases" target="_blank" rel="noopener">GitHub releases</a>
    </div>
  </section>
</Layout>
